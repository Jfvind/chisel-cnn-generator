# Normalise line endings so the same files work on Windows and Linux.
# Files that are parsed by Unix tools (make, bash, Tcl continuations, Python on the board)
# must keep LF even when checked out on Windows: a CR before a line-ending backslash
# breaks the continuation, and CRLF in a Makefile breaks GNU make on Linux.
* text=auto
Makefile  text eol=lf
*.mk      text eol=lf
*.tcl     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binary files: never touch
*.jpg     binary
*.png     binary
*.pt      binary
*.bit     binary


generator/generated/** text eol=lf
python/results/*.csv text eol=lf